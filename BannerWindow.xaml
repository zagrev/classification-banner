<Window x:Class="ClassificationBanner.BannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClassificationBanner"
        mc:Ignorable="d"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="False"
        Title="ClassificationBanner">
    <Grid x:Name="MainGrid">
        <!-- Left and right cells are overlaid on a single full-width cell so the center
             text stays centered on the screen regardless of how wide the side text is. -->
        <TextBlock x:Name="BannerTextLeft"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="BannerText"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="BannerTextRight"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
    </Grid>
</Window>
