<Application x:Class="ClassificationBanner.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClassificationBanner">
    <Application.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource ConfigFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource ConfigFontSize}"/>
            <Setter Property="FontWeight" Value="{DynamicResource ConfigFontWeight}"/>
            <Setter Property="FontStyle" Value="{DynamicResource ConfigFontStyle}"/>
        </Style>
        <Style TargetType="Border">
            <Setter Property="Padding" Value="15,0"/>
        </Style>
    </Application.Resources>
</Application>
